          "name": "closed",
          "when": "closed",
          "tone": "problem",
          "then": {
            "do": "hold"
          }
        },
        {
          "id": "3BC08394-0476-4DB9-A747-0BA2624A6447",
          "name": "checks failing",
          "when": "checksFailed",
          "tone": "problem",
          "then": {
            "do": "goto",
            "to": "ship",
            "max": 2
          }
        },
        {
          "id": "19440204-6B07-48BD-B2AD-9ECD8056CC58",
          "name": "has conflicts",
          "when": "conflicted",
          "tone": "problem",
          "then": {
            "do": "hold"
          }
        },
        {
          "id": "AEF8FA26-BA96-436B-9543-E8C57979FCF6",
          "name": "is behind",
          "when": "behind",
          "tone": "problem",
          "then": {
            "do": "goto",
            "to": "ship",
            "max": 2
          }
        },
        {
          "id": "B77D0CE7-667C-4D45-96D3-A42730A45A80",
          "name": "is approved",
          "when": "approved",
          "tone": "good",
          "then": {
            "do": "hold"
          }
        },
        {
          "id": "E64377FA-3239-401E-83B9-655A8440ABDB",
