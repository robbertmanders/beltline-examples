      "fallback": "hold"
    },
    {
      "id": "watch",
      "type": "watch",
      "name": "Merge",
      "model": "",
      "workspace": "readOnly",
      "writes": "pull request",
      "slots": 2,
      "brief": "",
      "outcomes": [
        {
          "id": "98D0A049-75C3-4E8F-BB79-1181812123FB",
          "name": "merged",
          "when": "merged",
          "tone": "good",
          "then": {
            "do": "ship"
          }
        },
        {
